{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/install",
        "destination": "/install.sh"
      },
      {
        "source": "/install-windows",
        "destination": "/install.ps1"
      }
    ],
    "headers": [
      {
        "source": "/install.*",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ],
    "site": "mnemoai"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}